# The persistent Gateway worker consumes exactly these four values.
# Store real values only in /etc/rlca/discord-worker.env with mode 0600.
DISCORD_BOT_TOKEN=replace-at-finalization
DISCORD_GUILD_ID=replace-at-finalization
RLCA_BACKEND_URL=https://rlcasystem.vercel.app
DISCORD_WORKER_SECRET=replace-at-finalization
