[Unit]
Description=RLCA Discord Gateway Worker
Documentation=https://github.com/damianeddins-sys/Rocket-League-Competitive-Association
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/rlca/discord-worker.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=rlca
Group=rlca
WorkingDirectory=/opt/rlca
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
EnvironmentFile=/etc/rlca/discord-worker.env
ExecStartPre=/usr/bin/test -r /etc/rlca/discord-worker.env
ExecStart=/usr/local/bin/node /opt/rlca/scripts/discord-gateway-worker.mjs
Restart=on-failure
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
SyslogIdentifier=rlca-discord-worker
MemoryHigh=384M
MemoryMax=640M
TasksMax=128
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
