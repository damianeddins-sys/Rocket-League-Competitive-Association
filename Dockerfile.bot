# syntax=docker/dockerfile:1
ARG NODE_VERSION=22.14.0

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS dependencies
WORKDIR /build
COPY deploy/discord-worker/package.json deploy/discord-worker/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM --platform=$TARGETPLATFORM node:${NODE_VERSION}-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY --from=dependencies --chown=node:node /build/node_modules ./node_modules
COPY --chown=node:node scripts/discord-gateway-worker.mjs ./scripts/discord-gateway-worker.mjs

USER node
HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
  CMD ["node", "-e", "const u=(process.env.RLCA_BACKEND_URL||'').replace(/\\/+$/,'');fetch(u+'/api/discord/health',{signal:AbortSignal.timeout(8000)}).then(r=>r.json()).then(h=>process.exit(h?.checks?.gatewayConnected&&h?.checks?.targetGuildConnected?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "scripts/discord-gateway-worker.mjs"]
